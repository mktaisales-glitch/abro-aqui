# Required for live data
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# NVIDIA Nemotron on Nebius Token Factory (without a key the app runs in template mode)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Models (defaults shown)
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_WRITER=nvidia/nemotron-3-super-120b-a12b
# LLM_DAILY_CAP=600            # model calls per day, all visitors
# LLM_DAILY_CAP_PER_IP=60      # model calls per visitor per day
# LLM_TIMEOUT_MS=25000         # per model call

# Tavily (checks launch partners on the web; optional)
TAVILY_API_KEY=

# Server
PORT=3000
# analyses per visitor per day
DAILY_LIMIT=30
# ROUTE_DEADLINE_MS=60000
# TRUST_PROXY=3                # Render: client -> Cloudflare -> balancer
# Cache: SQLite at CACHE_PATH locally; CACHE_MEMORY=1 keeps it in memory (Render free)
# CACHE_PATH=data/cache.sqlite
# CACHE_MEMORY=1
# CACHE_MAX_MB=64
# OFFLINE=1                    # replay recorded responses only (tests)
# Qloo client limiter
# QLOO_PARALLEL=3
# QLOO_GAP_MS=120
